# ==============================================================
# BACKEND CONFIGURATION TEMPLATE (.env.example)
# AI-Powered Client Support Chatbot SaaS
# ==============================================================

# Supabase Server Credentials (Service Role Key is server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini AI Integration (Official SDK)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=400

# Chat & Usage Limits
DAILY_MESSAGE_LIMIT=50
MAX_MESSAGE_LENGTH=1000

# Security & CORS
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_COOKIE_SAME_SITE=lax
PORT=5000
