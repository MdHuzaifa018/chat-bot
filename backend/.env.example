# ==============================================================
# BACKEND CONFIGURATION TEMPLATE (.env.example)
# Rename or copy this file to .env.local and fill in your values
# ==============================================================

# 1. SUPABASE DATABASE (Required)
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. GOOGLE GEMINI AI DIRECT INTEGRATION (Required for AI responses)
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024

# 3. CHAT CONFIGURATION & STUDENT USAGE LIMITS
DAILY_MESSAGE_LIMIT=8
MAX_MESSAGE_LENGTH=400

# 4. CLERK DASHBOARD AUTHENTICATION (Optional for admin panel)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# 5. SECURITY & CORS
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_COOKIE_SAME_SITE=lax
