# ==============================================================
# BACKEND CONFIGURATION TEMPLATE (.env.example)
# Rename or copy this file to .env.local and fill in your values
# ==============================================================

# 1. SUPABASE DATABASE (Required)
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. PRIMARY AI: DIFY AI + GEMINI 2.5 FLASH (Recommended)
# Dify App -> API Access -> API Key
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your_dify_api_key
DIFY_APP_MODE=chat
DIFY_WORKFLOW_INPUT_FIELD=query
DIFY_WORKFLOW_OUTPUT_FIELD=answer
DIFY_TIMEOUT_MS=15000

# 3. SECONDARY AI FAILOVER: GROQ (Optional)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# 4. EMERGENCY AI FAILOVER: OPENROUTER (Optional)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. STUDENT DAILY USAGE LIMIT (Phase 4)
# Maximum messages allowed per student client in 24 hours (default: 8)
DAILY_MESSAGE_LIMIT=8

# 6. CLERK DASHBOARD AUTHENTICATION (Phase 12)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# 7. SECURITY & CORS
ALLOWED_ORIGIN=http://localhost:3000

# 8. RATE LIMITING (Fixed Window Anti-Spam: 20 requests per 60 seconds)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# 9. COOKIE
SESSION_COOKIE_SAME_SITE=lax
